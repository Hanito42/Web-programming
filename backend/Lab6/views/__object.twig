{% extends "__layout.twig" %}

{% block content %}
<div class="container" style="padding-top: 30px">
    <text>{{ context['text'] }}</text>
    <ul class="nav nav-pills">
        <li class = nav-item>
            <a class="nav-link {{context['is_image'] ? "active" : ''}}" href="/{{context['upper_path']}}/image">Image</a>
        </li>
        <li class = nav-item>
            <a class="nav-link {{context['is_description'] ? "active" : ''}}" href="/{{context['upper_path']}}/description">Description</a>
        </li>
    </ul>
</div>
{% block objectContent %}{% endblock %}
{% endblock %}